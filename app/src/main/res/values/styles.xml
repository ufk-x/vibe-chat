<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#005FC9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#78B6FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0C0E12</item>
        <item name="android:navigationBarColor">#0C0E12</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0C0E12</item>
        <item name="android:colorBackground">#1C1F26</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
